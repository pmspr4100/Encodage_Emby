# ============================================================
#      OPTIMISEUR EMBY 10-BIT V20.5 (Stream's)
# ============================================================

$ErrorActionPreference = "SilentlyContinue"
[Console]::OutputEncoding = [System.Text.Encoding]::Default

$TxtSeries  = [System.Text.Encoding]::Default.GetString([byte[]]@(83, 233, 114, 105, 101, 115)) 
$TxtAnimes  = [System.Text.Encoding]::Default.GetString([byte[]]@(65, 110, 105, 109, 233, 115)) 
$TxtIgnore  = [System.Text.Encoding]::Default.GetString([byte[]]@(73, 71, 78, 79, 82, 201))     
$TxtTermine = [System.Text.Encoding]::Default.GetString([byte[]]@(84, 101, 114, 109, 105, 110, 233)) 

function Show-Menu {
    Clear-Host
    Write-Host "============================================" -ForegroundColor Cyan
    Write-Host "      OPTIMISEUR EMBY 10-BIT V20.5" -ForegroundColor Cyan
    Write-Host "============================================" -ForegroundColor Cyan
    Write-Host "[S] Cartoons     [T] Mangas      [U] $TxtSeries"
    Write-Host "[V] Spectacle    [W] Animations  [X] $TxtAnimes"
    Write-Host "[Y] Films        [Q] Quitter"
    Write-Host "--------------------------------------------"
}

$HB = Get-Command "HandBrakeCLI.exe" -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Source
if (-not $HB) { $HB = "C:\Program Files\HandBrake\HandBrakeCLI.exe" }
$T_DIR = "Z:\Encoder_Emby"
$L_BASE = "Z:\Encoder_Emby\Logs"

while ($true) {
    Show-Menu
    Write-Host "Appuyez sur une touche (Lecteur) : " -NoNewline
    $key = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
    $SEL = $key.Character.ToString().ToUpper()
    Write-Host "$SEL" -ForegroundColor Green

    if ($SEL -eq "Q") { break }
    if ("STUVWXY" -notlike "*$SEL*") { continue }

    $ROOT = "$($SEL):\"
    $L_ROOT = Join-Path $L_BASE "Logs_$SEL"
    if (-not (Test-Path $ROOT)) { Write-Host "[!] Lecteur introuvable." -ForegroundColor Red ; Start-Sleep 2 ; continue }

    # --- LOGIQUE DES LANGUES MISE A JOUR ---
    # Seuls T et W gardent le Japonais. X est désormais en Français uniquement.
    $LANG = if ("TW" -like "*$SEL*") { "jpn,fra" } else { "fra" }

    Write-Host "--- SCAN EN COURS SUR $ROOT ---" -ForegroundColor Yellow
    $Extensions = "*.mkv","*.mp4","*.avi","*.flv","*.mov","*.wmv","*.webm","*.m4v","*.mpg","*.mpeg"
    $files = Get-ChildItem -Path $ROOT -Include $Extensions -Recurse -File
    
    $total = $files.Count
    $current = 0

    foreach ($file in $files) {
        $current++
        $logPath = Join-Path $L_ROOT $file.DirectoryName.Replace($ROOT, "")
        $logFile = Join-Path $logPath "$($file.BaseName).txt"
        
        if (Test-Path -LiteralPath $logFile) {
            Write-Host "[$current/$total] [$TxtIgnore] $($file.Name)" -ForegroundColor Gray
            continue
        }

        Write-Host "--------------------------------------------------------"
        Write-Host "[$current/$total] [ACTION] -> $($file.Name)" -ForegroundColor White
        
        $TS = Get-Date -Format "HHmmss"
        $workOut = Join-Path $T_DIR "temp_$($SEL)_$($TS).mkv"

        if (-not (Test-Path $T_DIR)) { New-Item -ItemType Directory -Path $T_DIR }

        $hbArgs = "-i `"$($file.FullName)`" -o `"$workOut`" -e nvenc_h265_10bit -q 28 --encoder-preset fast --maxWidth 1920 --audio-lang-list $LANG -E av_aac -B 192 --all-subtitles --markers"
        Start-Process -FilePath $HB -ArgumentList $hbArgs -Wait -NoNewWindow

        if (Test-Path -LiteralPath $workOut) {
            if ((Get-Item -LiteralPath $workOut).Length -gt 1MB) {
                $oldPath = "$($file.FullName).old"
                Rename-Item -LiteralPath $file.FullName -NewName "$($file.Name).old" -Force
                $finalPath = Join-Path $file.DirectoryName "$($file.BaseName).mkv"
                Move-Item -LiteralPath $workOut -Destination $finalPath -Force

                if ($?) {
                    Remove-Item -LiteralPath $oldPath -Force
                    if (-not (Test-Path $logPath)) { New-Item -ItemType Directory -Path $logPath -Force }
                    "OK" | Out-File -LiteralPath $logFile
                    Write-Host "[OK] $TxtTermine." -ForegroundColor Green
                }
            }
            if (Test-Path -LiteralPath $workOut) { Remove-Item -LiteralPath $workOut -Force }
        }
    }
    Write-Host "`n--- DISQUE $SEL $TxtTermine ---" -ForegroundColor Cyan
    Start-Sleep 3
}