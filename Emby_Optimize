# ============================================================
#          OPTIMISEUR & AUDITEUR EMBY - ARCHITECTURE TER
# ============================================================

$ErrorActionPreference = "SilentlyContinue"
[Console]::OutputEncoding = [System.Text.Encoding]::Default

# --- CONFIGURATION DYNAMIQUE (PORTABLE) ---
# Récupère le dossier où se trouve le script, peu importe l'utilisateur ou le PC
$BASE_DIR    = $PSScriptRoot
if (-not $BASE_DIR) { $BASE_DIR = Get-Location }

$SOURCE_DIR  = Join-Path $BASE_DIR "Temp_Source"
$FINAL_DIR   = Join-Path $BASE_DIR "Fichier Final"
$TOOLS_DIR   = Join-Path $BASE_DIR "Tools"

# Chemins des outils
$HB = Join-Path $TOOLS_DIR "HandBrakeCLI.exe"
$FP = Join-Path $TOOLS_DIR "ffprobe.exe"

$T_DIR  = Join-Path $BASE_DIR "Temp_Work"
$L_BASE = Join-Path $BASE_DIR "Logs_Audit"

# Création automatique des dossiers
foreach ($dir in @($SOURCE_DIR, $T_DIR, $L_BASE, $FINAL_DIR)) { 
    if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null } 
}

# ============================================================
# FONCTIONS
# ============================================================

function Start-Audit-Local {
    if (-not (Test-Path $FP)) { Write-Host "[!] ffprobe.exe introuvable dans Tools." -ForegroundColor Red; return }
    $AuditLog = Join-Path $L_BASE "Rapport_Audit_$(Get-Date -Format 'yyyyMMdd_HHmm').txt"
    Write-Host "`n--- SCAN DE : $SOURCE_DIR ---" -ForegroundColor Magenta
    $aFiles = Get-ChildItem -Path $SOURCE_DIR -Include "*.mkv","*.mp4","*.ts","*.avi" -Recurse -File
    $count = 0
    foreach ($f in $aFiles) {
        $probe = & $FP -v error -select_streams v:0 -show_entries stream=codec_name,pix_fmt -of csv=p=0:s="|" "$($f.FullName)"
        if ($probe -notlike "hevc*10*") {
            Write-Host "[X] A ENCODER : $($f.Name)" -ForegroundColor Yellow
            "$($f.FullName) | Codec actuel: $probe" | Out-File $AuditLog -Append -Encoding utf8
            $count++
        } else { Write-Host "[V] CONFORME  : $($f.Name)" -ForegroundColor Gray }
    }
    Write-Host "`nAudit fini. $count fichiers à traiter." -ForegroundColor Green
    if ($count -gt 0) { Start-Process notepad.exe $AuditLog }
    Start-Sleep -Seconds 3
}

function Start-Encoding {
    param([string]$Type)

    if (-not (Test-Path $HB)) { Write-Host "[!] HandBrakeCLI.exe introuvable !" -ForegroundColor Red; Start-Sleep 3; return }

    if ($Type -eq "GPU") {
        $encoder = "nvenc_h265_10bit"
        $preset  = "fast"
        $crf     = "25"
        $modeName = "GPU NVIDIA"
    } else {
        $encoder = "x265_10bit"
        $preset  = "medium"
        $crf     = "22"
        $modeName = "CPU (x265)"
    }

    Write-Host "`n--- LANCEMENT ENCODAGE $modeName ---" -ForegroundColor Green
    $files = Get-ChildItem -Path $SOURCE_DIR -Include "*.mkv","*.mp4","*.avi","*.ts" -Recurse -File
    
    foreach ($file in $files) {
        $logDir = Join-Path $L_BASE "Encodage_Logs"
        if (-not (Test-Path $logDir)) { New-Item -ItemType Directory -Path $logDir -Force | Out-Null }
        $logFile = Join-Path $logDir "$($file.BaseName).txt"

        if (Test-Path $logFile) {
            Write-Host "[-] DEJA FAIT : $($file.Name)" -ForegroundColor Gray
            continue
        }

        Write-Host "--------------------------------------------"
        Write-Host "[TRAVAIL] -> $($file.Name)" -ForegroundColor White
        
        $finalOut = Join-Path $FINAL_DIR "$($file.BaseName).mkv"

        # CORRECTION : Utilisation de sélecteurs de pistes valides au lieu de "all"
        # On demande à HandBrake de copier les pistes audio existantes (1 à 10 par sécurité)
        $hbArgs = "-i `"$($file.FullName)`" -o `"$finalOut`" -e $encoder -q $crf --encoder-preset $preset --audio `"1,2,3,4,5`" --aencoder copy --audio-fallback av_aac --all-subtitles --markers"
        
        Start-Process -FilePath $HB -ArgumentList $hbArgs -Wait -NoNewWindow

        if (Test-Path $finalOut) {
            if ((Get-Item $finalOut).Length -gt 1MB) {
                "OK (Mode:$Type)" | Out-File $logFile -Encoding utf8
                Write-Host "[OK] Terminé." -ForegroundColor Green
            } else {
                if (Test-Path $finalOut) { Remove-Item $finalOut -Force }
                Write-Host "[!] Erreur : Sortie corrompue ou accès refusé." -ForegroundColor Red
            }
        }
    }
    Write-Host "`n--- TRAITEMENT TERMINE ---" -ForegroundColor Cyan
    Start-Sleep 5
}

# ============================================================
# BOUCLE PRINCIPALE
# ============================================================

while ($true) {
    Clear-Host
    Write-Host "============================================" -ForegroundColor Cyan
    Write-Host "      EMBY OPTIMIZER V22 (PORTABLE)"          -ForegroundColor Cyan
    Write-Host "============================================" -ForegroundColor Cyan
    Write-Host " Dossier Root : $BASE_DIR"                   -ForegroundColor Gray
    Write-Host " Source       : $SOURCE_DIR"                  -ForegroundColor Gray
    Write-Host "--------------------------------------------"
    Write-Host "[G] ENCODAGE GPU (NVIDIA NVENC)"             -ForegroundColor Green
    Write-Host "[C] ENCODAGE CPU (x265 High Quality)"        -ForegroundColor Yellow
    Write-Host "[A] AUDIT (Scan des fichiers)"               -ForegroundColor Magenta
    Write-Host "--------------------------------------------"
    Write-Host "[Q] QUITTER"
    Write-Host "--------------------------------------------"
    
    $key = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
    $SEL = $key.Character.ToString().ToUpper()

    if ($SEL -eq "Q") { break }
    if ($SEL -eq "G") { Start-Encoding -Type "GPU" }
    if ($SEL -eq "C") { Start-Encoding -Type "CPU" }
    if ($SEL -eq "A") { Start-Audit-Local }
}